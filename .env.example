# Server-only settings. Set these in Vercel Settings > Environment Variables.
# Copy to .env for local development; never commit real credentials.
SVG_SUPABASE_URL=""
# Use a publishable/anon key for Supabase Auth.
SVG_SUPABASE_PUBLISHABLE_KEY=""
# Use a secret/service_role key for server-side database operations only.
SVG_SUPABASE_SECRET_KEY=""
# Optional legacy key types (choose one of each type, not both).
SVG_SUPABASE_ANON_KEY=""
SVG_SUPABASE_SERVICE_ROLE_KEY=""
# Comma-separated VERIFIED Supabase Auth user emails allowed to administer the site.
# Empty = no one can access admin or modify library records.
SVG_ADMIN_EMAILS=""
# Optional SQL connection string. REST operations use the URL and secret key above.
SVG_DATABASE_URL=""
# Local importer only. Vercel cannot read folders on your personal computer.
SVG_FA_PRO_DIR="./assets/sample-fa-pro"
